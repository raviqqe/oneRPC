{
  "name": "onerpc",
  "version": "0.6.12",
  "description": "The RPC library for the serverless and TypeScript era.",
  "license": "MIT",
  "repository": "https://github.com/raviqqe/onerpc",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "default": "./dist/middleware.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "default": "./dist/validation.js"
    },
    "./adapter/*": {
      "types": "./dist/adapter/*.d.ts",
      "default": "./dist/adapter/*.js"
    }
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "rslib build",
    "build:tsc": "tsc --emitDeclarationOnly",
    "build:doc": "deno doc --unstable-sloppy-imports --unstable-byonm --html --name='⚡ oneRPC' src/index.ts src/client.ts src/middleware.ts src/validation.ts src/adapter/*.ts",
    "prepack": "cp ../../README.md .",
    "test": "vitest --coverage"
  },
  "dependencies": {
    "@raviqqe/hidash": "^2.0.3",
    "@raviqqe/loscore": "^0.3.0",
    "es-toolkit": "^1.52.0"
  },
  "devDependencies": {
    "@raviqqe/tsconfig": "^3.0.0",
    "@rslib/core": "^1.0.2",
    "@types/aws-lambda": "^8.10.163",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "valibot": "^1.5.0",
    "zod": "^4.6.5"
  }
}
